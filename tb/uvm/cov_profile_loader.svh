// SPDX-License-Identifier: BSD-3-Clause
// emulator_mutrig DV — coverage profile loader
//
// Hard-coded table of per-case coverage bins and random-promotion knobs.
// Generated from `tb/cov_profiles.json` — do NOT edit by hand; regenerate via the build script in `tb/scripts/build_cov_profiles.py`.
//
// Questa FSE Starter Edition constraints (per /home/yifeng/CLAUDE.md):
//   - no `covergroup` / no `rand` / no DPI;
//   - LCG-based PRNG provided locally;
//   - per-bin counters in a flat `int unsigned` array.

`ifndef EMUT_COV_PROFILE_LOADER_SVH
`define EMUT_COV_PROFILE_LOADER_SVH

package emut_cov_profile_pkg;

  localparam int unsigned COV_N_CASES = 512;
  localparam int unsigned COV_N_BINS  = 336;

  // Per-bin hit counters. Increment via `cov_record_bins`.
  int unsigned cov_bin_count [COV_N_BINS];

  // --------------------------------------------------------------------
  // LCG state and helpers (Questa FSE: no `rand`).
  // --------------------------------------------------------------------
  bit [31:0] emut_lcg_state = 32'h1;

  function automatic void emut_lcg_seed(input bit [31:0] seed);
    emut_lcg_state = (seed == 32'h0) ? 32'h1 : seed;
  endfunction

  function automatic bit [31:0] emut_lcg_next();
    // Numerical Recipes LCG (Park-Miller variant).
    emut_lcg_state = emut_lcg_state * 32'h0019_660D + 32'h3C6E_F35F;
    return emut_lcg_state;
  endfunction

  function automatic bit [31:0] emut_lcg_uniform_int(input bit [31:0] lo, input bit [31:0] hi);
    bit [63:0] span;
    bit [31:0] r;
    if (hi <= lo) return lo;
    span = hi - lo + 1;
    r = emut_lcg_next();
    return lo + bit'(r % span[31:0]);
  endfunction

  function automatic int emut_lcg_uniform_int_signed(input int lo, input int hi);
    int span;
    bit [31:0] r;
    if (hi <= lo) return lo;
    span = hi - lo + 1;
    r = emut_lcg_next();
    return lo + int'(r % span);
  endfunction

  // --------------------------------------------------------------------
  // Bin name table — index ↔ name mapping.
  // --------------------------------------------------------------------
  string cov_bin_name [COV_N_BINS];

  function automatic int cov_bin_index_of(string name);
    for (int i = 0; i < COV_N_BINS; i++) begin
      if (cov_bin_name[i] == name) return i;
    end
    return -1;
  endfunction

  // Bin → case-id list is built by the case table init.
  // For Questa FSE compactness we use a flat 2-level lookup: case-id index → list of bin-name strings, plus case-id index → list of (knob, lo, hi) tuples.

  string  cov_case_id        [COV_N_CASES];
  string  cov_case_bins      [COV_N_CASES][];
  string  cov_case_knob_name [COV_N_CASES][];
  bit [31:0] cov_case_knob_lo [COV_N_CASES][];
  bit [31:0] cov_case_knob_hi [COV_N_CASES][];
  bit        cov_case_knob_is_signed [COV_N_CASES][];
  bit        cov_case_promoted [COV_N_CASES];

  function automatic int cov_case_index_of(string id);
    for (int i = 0; i < COV_N_CASES; i++) begin
      if (cov_case_id[i] == id) return i;
    end
    return -1;
  endfunction

  // --------------------------------------------------------------------
  // Public API:
  //   cov_record_bins(case_id) — increment counters for
  //     every bin the case owns (no-op if id unknown).
  //   cov_promoted_value(case_id, knob_name) — return a
  //     fresh LCG sample inside that case's knob neighbourhood.
  //     Falls through to 0 if the knob is not declared for the case.
  // --------------------------------------------------------------------

  function automatic void cov_record_bins(string case_id);
    int ci;
    int bi;
    ci = cov_case_index_of(case_id);
    if (ci < 0) return;
    for (int k = 0; k < cov_case_bins[ci].size(); k++) begin
      bi = cov_bin_index_of(cov_case_bins[ci][k]);
      if (bi >= 0) cov_bin_count[bi] = cov_bin_count[bi] + 1;
    end
  endfunction

  function automatic int unsigned cov_promoted_value(string case_id, string knob_name);
    int ci;
    ci = cov_case_index_of(case_id);
    if (ci < 0) return 32'h0;
    for (int k = 0; k < cov_case_knob_name[ci].size(); k++) begin
      if (cov_case_knob_name[ci][k] == knob_name) begin
        if (cov_case_knob_is_signed[ci][k])
          return bit'(emut_lcg_uniform_int_signed(
            int'(cov_case_knob_lo[ci][k]),
            int'(cov_case_knob_hi[ci][k])));
        else
          return emut_lcg_uniform_int(
            cov_case_knob_lo[ci][k],
            cov_case_knob_hi[ci][k]);
      end
    end
    return 32'h0;
  endfunction

  function automatic bit cov_case_is_promoted(string case_id);
    int ci;
    ci = cov_case_index_of(case_id);
    if (ci < 0) return 1'b0;
    return cov_case_promoted[ci];
  endfunction

  // --------------------------------------------------------------------
  // Static initializer — populates bin and case tables.
  // --------------------------------------------------------------------

